ParseSkinTable(html) {
    result := {}

    ; Titel extrahieren
    if RegExMatch(html, "<th[^>]*>(.*?)</th>", m)
        result.Title := Trim(m1)
    else
        result.Title := "Unbekannt"

    ; IDs extrahieren
    result.Skins := []
    pos := 1

    pattern := "href=""\/ingameshop\/skin\/[^\/]+\/(\d+)"""

    while pos := RegExMatch(html, pattern, m, pos) {
        pos += StrLen(m)
        result.Skins.Push(m1 + 0)
    }

    return result
}



process_skins(html)
{
    result := {}
    result.civ := ""
    result.fac := ""

    tables := StrSplit(html, "<table")

    for i, t in tables {
        if InStr(t, "civilianSkinID")
            result.civ := ParseSkinTable(t)
        if InStr(t, "factionSkinID")
            result.fac := ParseSkinTable(t)
    }
    return result
}


ParseAllSkinTables(html) {
    tables := []
    pos := 1

    while pos := RegExMatch(html, "s)<table[^>]*>(.*?)</table>", m, pos) {
        pos += StrLen(m)
        tableHtml := m1

        if InStr(tableHtml, "/ingameshop/skin/")
            tables.Push(ParseSkinTable(tableHtml))
    }

    return tables
}

GetSkinCategories(html) {
    data := {}
    data.civ := []
    data.fac := []
    data.all := []

    tables := ParseAllSkinTables(html)

    for i, t in tables {
        title := t.Title

        if InStr(title, "Zivil") {
            for j, id in t.Skins
                data.civ.Push(id)
        }
        else if InStr(title, "Fraktion") {
            for j, id in t.Skins
                data.fac.Push(id)
        }

        ; ALL bekommt ALLES
        for j, id in t.Skins
            data.all.Push(id)
    }

    return data
}



cp_getSkins()
{
    cp_Login()
    response := http_Request("GET","https://samp.cp.life-of-german.org/ingameshop/skin","")

    return response
}

cp_select_skin(id)
{
    global skins

    if (skins.civ.HasKey(id)) {
        url := "https://samp.cp.life-of-german.org/ingameshop/skin/civilianSkinID/" id
    }
    else if (skins.fac.HasKey(id)) {
        url := "https://samp.cp.life-of-german.org/ingameshop/skin/factionSkinID/" id
    }
    else {
        AddChatMessage("{FF0000}Ungültige Skin-ID: " id)
        return
    }


    http_Request("GET", url, "")
    cp_Logout()
}


