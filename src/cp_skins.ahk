        AddChatMessage("Treffer: " Skins[id].Name)
    else
        AddChatMessage("NICHT gefunden: " id)
}


    for i, id in ids {
        AddChatMessage(id)
        if (Skins.HasKey(id)) {
            name := Skins[id].Name
            AddChatMessage(name)
            gender := Skins[id].Gender
        } else {
            name := "Unbekannt"
